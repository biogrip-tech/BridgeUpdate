# device.env — identidad de red de ESTE Luckfox.
#
# Este archivo lo lee udp-lsl.service (systemd EnvironmentFile). NUNCA se
# versiona igual en dos dispositivos: cada Luckfox debe tener su propia
# subred para poder identificarlo sin ambigüedad y para que varias unidades
# puedan operar en el mismo espacio físico sin pisarse.
#
# Generado automáticamente por network/generate-device-network.sh.
# Destino en el Luckfox: /etc/synaptic-bridge/device.env

# Interfaz WiFi que hace de punto de acceso
AP_IFACE=wlan0

# IP + máscara que este Luckfox se asigna a sí mismo en su propia red.
# Debe coincidir con el listen-address de dnsmasq.conf (mismo 4).
AP_IP=192.168.4.1/24

# Solo informativo (para logs/journalctl), no lo usa el servicio directamente.
DEVICE_NAME=synaptic-bridge41
